# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
/coverage/

# AI tooling caches
.claude-flow/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
node_modules/*
# LaTeX build artifacts (keep .tex source and the built .pdf)
docs/*.aux
docs/*.fdb_latexmk
docs/*.fls
docs/*.out
docs/*.synctex.gz
docs/*.toc
claude/

# Trace archives and the collector database never belong in git —
# a 735 MB tarball once rode a bulk git add into history and killed a push.
*.tar.gz
trace_server/data/

# Build-time secrets (TRACE_TOKEN). Never commit.
.env

# LaTeX build products for the standalone chapter build
docs/*.aux
docs/*.log
docs/*.out
docs/*.fls
docs/*.fdb_latexmk
docs/*.toc

# Writing and local tooling stay out of the repo.
docs/thesis/
docs/overleaf_handoff.zip
docs/architecture-overview.*
docs/experiment_log.md
.claude/
