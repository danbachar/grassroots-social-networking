trace-upload.bachar.co {
	encode gzip

	# Matches the app server's own body limit so oversized requests are
	# rejected at the edge rather than after a full upload. Sized for a
	# multi-hour saturating experiment (~20 MB gzipped), not as a policy on
	# how large an experiment may be.
	request_body {
		max_size 64MB
	}

	reverse_proxy trace:8443

	log {
		output stdout
		format console
	}
}
